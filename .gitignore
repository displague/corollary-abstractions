# Local virtual environments (uv)
.venv/

# Worktrees for parallel subagent work
.worktrees/

# Experiment artifacts: generated datasets, model checkpoints, run logs
# (experiments/visual/fixtures/ is deliberately NOT ignored: a few KB of
# diffable text is the only way a silent change to the emitted SVG/JSON byte
# format shows up in review)
experiments/visual/out/
experiments/data/
experiments/data_smoke/
experiments/results/**/*.pt
experiments/results/**/*.log
experiments/results/**/*.pt.tmp
experiments/results/**/*.json.tmp
experiments/*.log

# Real corpus samples (licensed downloads, user-provided; never commit)
experiments/data_real/

# Runtime-owned private state (ROADMAP-v0.7 item 2). The session root keys and
# the monotone anti-rollback counters live here. Committing this file would
# hand every forger the ability to mint any binding for any owner, which is
# precisely the threat model scripts/session_keys.py names as its weakest
# point. Session *files* are public and may be committed; this never is.
.runtime/
*.session-keys.json

# Secrets — never commit
.env
.env.*
