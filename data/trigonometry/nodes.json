          "trigonometry"
        ],
        "subfield": "circular_functions",
        "topic": "ratios"
      },
      "formal_statement": {
        "canonical_ascii": "tan(x) = sin(x)/cos(x)",
        "canonical_latex": "\\tan x = \\dfrac{\\sin x}{\\cos x}",
        "equivalent_forms": [
          {
            "form_id": "cotangent",
            "notation_system": "ascii",
            "expression": "cot(x) = cos(x)/sin(x)",
            "scope_note": "Reciprocal ratio where sin(x) is nonzero"
          }
        ]
      },
      "structural_signature": {
