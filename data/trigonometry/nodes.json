    {
      "statement_id": "trigonometry.identities.pythagorean",
      "title": "Pythagorean Identity",
      "statement_class": "identity",
      "epistemic_status": "derived",
      "theory_context": {
        "disciplines": [
          "trigonometry"
        ],
        "subfield": "circular_functions",
        "topic": "fundamental_identities"
      },
      "formal_statement": {
        "canonical_ascii": "sin(x)^2 + cos(x)^2 = 1",
        "canonical_latex": "\\sin^2 x + \\cos^2 x = 1",
        "equivalent_forms": [
          {
            "form_id": "tangent_secant",
            "notation_system": "ascii",
            "expression": "1 + tan(x)^2 = sec(x)^2",
            "scope_note": "Divide through by cos(x)^2 where cos(x) is nonzero"
          },
          {
            "form_id": "sine_from_cosine",
            "notation_system": "ascii",
            "expression": "sin(x)^2 = 1 - cos(x)^2",
            "scope_note": "Solved for the squared sine"
          }
        ]
      },
      "structural_signature": {
        "archetype_id": "unit_circle_constraint",
        "anonymized_template": "SIN(ANGLE)^2 + COS(ANGLE)^2 = 1",
        "slot_schema": [
          {
            "slot_id": "ANGLE",
            "syntactic_category": "variable",
            "semantic_role": "angle"
          }
        ],
        "invariants": [
          "Holds for every real angle without exception.",
          "Even in the angle: the identity is unchanged under ANGLE -> -ANGLE.",
          "The single constraint that a point (COS, SIN) lies on the unit circle."
        ]
      },
      "symbol_lexicon": {
        "symbols": [
          {
            "symbol": "x",
            "syntactic_category": "variable",
            "semantic_role": "angle",
            "mathematical_order": 0,
            "description": "An angle, measured in radians."
          }
        ],
        "operators": [
          {
            "symbol": "=",
            "name": "equality",
            "arity": 2,
            "operator_family": "relational"
          },
          {
            "symbol": "+",
            "name": "addition",
            "arity": 2,
            "operator_family": "arithmetic"
          },
          {
            "symbol": "^",
            "name": "exponentiation",
            "arity": 2,
            "operator_family": "arithmetic"
          }
        ],
        "functionals": [
          {
            "notation": "SIN(.)",
            "name": "sine",
            "input_arity": 1,
            "codomain": "[-1, 1]",
            "description": "Sine of an angle (radians); ordinate on the unit circle."
          },
          {
            "notation": "COS(.)",
            "name": "cosine",
            "input_arity": 1,
            "codomain": "[-1, 1]",
            "description": "Cosine of an angle (radians); abscissa on the unit circle."
          }
        ],
        "index_sets": [],
        "constants": []
      },
      "semantic_interpretation": {
        "statement_meaning": "The squared sine and squared cosine of any angle sum to one: the coordinates of a unit-circle point satisfy the circle's equation.",
        "statistical_significance": "The foundational circular identity; a squared-sum equal to a constant, distinguished from the Pythagorean theorem it descends from by the SIN and COS heads wrapping its slots rather than free legs.",
        "regularity_conditions": [
          "Angle measured in radians (or any consistent measure)",
          "Real-valued angle"
        ]
      },
