      "title": "Pythagorean Theorem",
      "statement_class": "theorem",
      "epistemic_status": "formal",
      "theory_context": {
        "disciplines": [
          "mathematics",
          "geometry"
        ],
        "subfield": "euclidean_geometry",
        "topic": "right_triangles"
      },
      "formal_statement": {
        "canonical_ascii": "a^2 + b^2 = c^2",
        "canonical_latex": "a^2 + b^2 = c^2",
