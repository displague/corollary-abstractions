{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corollary-abstractions.local/schema/mathematical-statement-node.schema.json",
  "title": "Mathematical Statement Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement_id",
    "title",
    "statement_class",
    "epistemic_status",
    "theory_context",
    "formal_statement",
    "structural_signature",
    "symbol_lexicon",
    "semantic_interpretation",
    "inferential_links"
  ],
  "properties": {
    "statement_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement_class": {
      "type": "string",
      "enum": [
        "axiom",
        "definition",
        "lemma",
        "proposition",
        "theorem",
        "corollary",
        "identity",
        "model_specification",
        "estimator",
        "transformation",
        "approximation"
      ]
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "formal",
        "derived",
        "assumed",
        "asymptotic",
        "empirical",
        "conjectured"
      ]
    },
    "theory_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disciplines",
        "subfield",
        "topic"
      ],
      "properties": {
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "subfield": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "canonical_objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "formal_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_ascii",
        "equivalent_forms"
      ],
      "properties": {
        "canonical_ascii": {
          "type": "string",
          "minLength": 1
        },
        "canonical_latex": {
          "type": "string"
        },
        "equivalent_forms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formalVariant"
          }
        }
      }
    },
    "structural_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_id",
        "anonymized_template",
        "slot_schema",
        "invariants"
      ],
      "properties": {
        "archetype_id": {
          "type": "string",
          "minLength": 1
        },
        "anonymized_template": {
          "type": "string",
          "minLength": 1
        },
        "slot_schema": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signatureSlot"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "symbol_lexicon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbols",
        "operators",
        "functionals",
        "index_sets",
        "constants"
      ],
      "properties": {
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/symbolToken"
          }
        },
        "operators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operatorToken"
          }
        },
        "functionals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/functionalToken"
          }
        },
        "index_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indexSet"
          }
        },
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constantToken"
          }
        }
      }
    },
    "semantic_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_meaning",
        "statistical_significance",
        "regularity_conditions"
      ],
      "properties": {
        "statement_meaning": {
          "type": "string",
          "minLength": 1
        },
        "statistical_significance": {
          "type": "string",
          "minLength": 1
        },
        "regularity_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inferential_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entailed_by",
        "entails",
        "equivalent_to",
        "special_case_of",
        "generalizes",
        "composed_with"
      ],
      "properties": {
        "entailed_by": {
          "$ref": "#/$defs/nodeIdList"
        },
        "entails": {
          "$ref": "#/$defs/nodeIdList"
        },
        "equivalent_to": {
          "$ref": "#/$defs/nodeIdList"
        },
        "special_case_of": {
          "$ref": "#/$defs/nodeIdList"
        },
        "generalizes": {
          "$ref": "#/$defs/nodeIdList"
        },
        "composed_with": {
          "$ref": "#/$defs/nodeIdList"
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verified_by": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "artifact"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "formalVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "notation_system",
        "expression"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "minLength": 1
        },
        "notation_system": {
          "type": "string",
          "enum": [
            "ascii",
            "latex",
            "matrix_notation",
            "event_probability",
            "measure_theoretic",
            "vector_notation"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "scope_note": {
          "type": "string"
        }
      }
    },
    "signatureSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "syntactic_category",
        "semantic_role"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "syntactic_category": {
          "type": "string",
          "enum": [
            "variable",
            "parameter",
            "random_variable",
            "statistic",
            "functional",
            "operator",
            "set",
            "index",
            "sequence",
            "distribution",
            "constant"
          ]
        },
        "semantic_role": {
          "type": "string",
          "minLength": 1
        },
        "admissible_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "symbolToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "syntactic_category",
        "semantic_role",
        "mathematical_order",
        "description"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "syntactic_category": {
          "type": "string",
          "enum": [
            "variable",
            "parameter",
            "random_variable",
            "statistic",
            "set",
            "index",
            "sequence",
            "distribution",
            "constant"
          ]
        },
        "semantic_role": {
          "type": "string",
          "minLength": 1
        },
        "mathematical_order": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operatorToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "arity",
        "operator_family"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arity": {
          "type": "integer",
          "minimum": 1
        },
        "operator_family": {
          "type": "string",
          "enum": [
            "arithmetic",
            "relational",
            "logical",
            "set_theoretic",
            "measure_theoretic",
            "stochastic",
            "limit"
          ]
        }
      }
    },
    "functionalToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "name",
        "input_arity",
        "description"
      ],
      "properties": {
        "notation": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input_arity": {
          "type": "integer",
          "minimum": 1
        },
        "codomain": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "indexSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "domain",
        "description"
      ],
      "properties": {
        "notation": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constantToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "description"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_key",
        "bibliographic_entry"
      ],
      "properties": {
        "citation_key": {
          "type": "string",
          "minLength": 1
        },
        "bibliographic_entry": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      }
    },
    "nodeIdList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
